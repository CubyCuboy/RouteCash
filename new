serve(async (req) => {
  if (req.method === 'OPTIONS') return new Response('ok', { headers: corsHeaders });

  try {
    const { user_id, email, purpose, lang = 'es' } = await req.json();
    if (!user_id || !purpose) throw new Error('user_id y purpose son obligatorios');

    const supabase = createClient(Deno.env.get('SUPABASE_URL') ?? '', Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') ?? '');

    let targetEmail = email?.toString().trim().toLowerCase();
    if (!targetEmail) {
      const { data } = await supabase.from('users').select('email').eq('user_id', user_id).single();
      targetEmail = data?.email;
    }

    if (!targetEmail) throw new Error('Correo no encontrado');

    const code = Math.floor(100000 + Math.random() * 900000).toString();
    const minutes = purpose === 'reset_password' ? 5 : (purpose === 'change_email' ? 10 : 30);
    const expiresAt = new Date(Date.now() + minutes * 60 * 1000).toISOString();

    await supabase.from('user_otps').update({ is_used: true }).eq('user_id', user_id).eq('purpose', purpose).eq('is_used', false);
    await supabase.from('user_otps').insert({ user_id, code, purpose, is_used: false, expires_at: expiresAt });

    const langData = translations[lang] || translations['es'];
    const pKey = purpose === 'reset_password' ? 'reset' : (purpose === 'change_email' ? 'change' : 'verify');
    const msg = langData[pKey];

    const res = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        service_id: Deno.env.get('EMAILJS_SERVICE_ID'),
        template_id: Deno.env.get('EMAILJS_TEMPLATE_ID'),
        user_id: Deno.env.get('EMAILJS_PUBLIC_KEY'),
        accessToken: Deno.env.get('EMAILJS_PRIVATE_KEY'),
        template_params: { to_email: targetEmail, code, ...msg }
      }),
    });

    return new Response(JSON.stringify({ success: res.ok }), { headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
  } catch (e) {
    return new Response(JSON.stringify({ success: false, error: e.message }), { status: 400, headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
  }
});